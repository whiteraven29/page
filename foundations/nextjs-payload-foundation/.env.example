# Copy to .env and fill in. Never commit the real .env.
# SQLite for quick local work, or PostgreSQL (make db) to match production:
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgres://app:app@localhost:5432/app
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Foundation
APP_VERSION=0.1.0
# First admin created by `npm run seed` (or create it on the /admin screen):
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
